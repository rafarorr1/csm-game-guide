; PICA200: un hueso rígido por vértice, igual que los modelos originales.
.fvec proyeccion[4]
.fvec modelo[4]
.fvec huesos[72]
.fvec tinte
.constf base(0.0,1.0,0.36,0.64)
.constf luna(-0.35,0.85,0.39,0.0)
.out posicion position
.out color color
.alias entrada v0
.alias pigmento v1
.alias normal v2
.alias hueso v3
.proc main
 mov r0.xyz, entrada
 mov r0.w, base.y
 mova a0.x, hueso.x
 dp4 r1.x, huesos[a0.x], r0
 dp4 r1.y, huesos[a0.x+1], r0
 dp4 r1.z, huesos[a0.x+2], r0
 mov r1.w, base.y
 dp4 r2.x, modelo[0], r1
 dp4 r2.y, modelo[1], r1
 dp4 r2.z, modelo[2], r1
 mov r2.w, base.y
 dp4 posicion.x, proyeccion[0], r2
 dp4 posicion.y, proyeccion[1], r2
 dp4 posicion.z, proyeccion[2], r2
 dp4 posicion.w, proyeccion[3], r2
 dp3 r3.x, huesos[a0.x], normal
 dp3 r3.y, huesos[a0.x+1], normal
 dp3 r3.z, huesos[a0.x+2], normal
 dp3 r4.x, modelo[0], r3
 dp3 r4.y, modelo[1], r3
 dp3 r4.z, modelo[2], r3
 dp3 r5.x, luna, r4
 max r5.x, r5.x, base.x
 mul r5.x, r5.x, base.w
 add r5.x, r5.x, base.z
 mul r6.xyz, pigmento, r5.xxx
 mul color.xyz, tinte, r6
 mov color.w, tinte.w
 end
.end
